# /etc/restic/env (chmod 600): read by vps-forge-backup.sh
# Repository: pick ONE
RESTIC_REPOSITORY='s3:https://s3.<region>.backblazeb2.com/<bucket>/<hostname>'
# RESTIC_REPOSITORY='s3:https://<accountid>.r2.cloudflarestorage.com/<bucket>/<hostname>'
# RESTIC_REPOSITORY='sftp:uXXXXX@uXXXXX.your-storagebox.de:/backups/<hostname>'   # Hetzner Storage Box (port 23 via /root/.ssh/config)
# RESTIC_REPOSITORY='rest:https://user:pass@backup.example.com/<hostname>'          # rest-server --append-only

RESTIC_PASSWORD_FILE='/etc/restic/password'

# S3-compatible credentials (B2 / R2 / S3 / Wasabi). Scope the key to this one bucket.
AWS_ACCESS_KEY_ID=''
AWS_SECRET_ACCESS_KEY=''

# healthchecks.io check (period 1 day, grace 6 h). The script appends /start and /fail.
HC_URL=''

# Retention (maintenance timer)
KEEP_DAILY=7
KEEP_WEEKLY=4
KEEP_MONTHLY=12
CHECK_SUBSET='5%'
